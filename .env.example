# ── 数据库 ──────────────────────────────────────────────
# 留空 = 使用进程内 PGlite（本地开发/测试）
# 部署机必须填真实连接串
NUCLEUS_DATABASE_URL=

# PGlite 的持久化目录；留空 = 内存（测试用）
NUCLEUS_PGLITE_DIR=.nucleus-data/pglite

# ── Provider 凭据 ───────────────────────────────────────
# 推荐用 `nucleus auth login <REF>` 而不是写在这里 ——
# 那样密钥进 keychain 或 0600 文件，不会误提交。
# 这里填的话优先级最高（会覆盖 keychain 与文件）。
#
# 有 API key 的（GLM / Kimi 的订阅提供）
# ZAI_API_KEY=          # GLM（zai:glm-5.2 等）
# KIMI_API_KEY=         # Kimi（kimi:k3，走 anthropic-messages 协议）
#
# OpenAI 与 Grok 的订阅**不发 API key**，只能走 OAuth：
#   nucleus auth login OPENAI_OAUTH --oauth --provider openai
#   nucleus auth login XAI_OAUTH --oauth --provider xai
# 需要先在 nucleus.config.json 的 oauthProviders 里配置 clientId。
# token 存在 keychain / 凭据文件里，不写在这。

# 本地 ollama（可选）
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── 运行时 ──────────────────────────────────────────────
# agent 的工作目录根。生产建议改成持久路径，而不是 /tmp
# NUCLEUS_WORKDIR=/var/lib/nucleus/work

# 配置文件位置；默认在 cwd 找 nucleus.config.json
# NUCLEUS_CONFIG=/etc/nucleus/nucleus.config.json

# ── 服务（serve 命令尚未实现）──────────────────────────
NUCLEUS_BIND=127.0.0.1
NUCLEUS_PORT=8787
# 空 = 启动时生成并打印一次；生产必须显式设置
NUCLEUS_API_TOKEN=
