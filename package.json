{
  "name": "nucleus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": { "nucleus": "dist/cli/index.js" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:record": "NUCLEUS_RECORD=1 vitest run --config vitest.live.config.ts",
    "cli": "npm run build --silent && node dist/cli/index.js",
    "doctor": "npm run build --silent && node dist/cli/index.js doctor",
    "verify": "npm run build --silent && node dist/cli/index.js verify",
    "migrate": "npm run build --silent && node dist/cli/index.js migrate"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
